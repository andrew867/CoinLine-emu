+bool win_window_info::begin_window_drag(int hit, POINT const &where)
+{
+	// Keep the upstream modal behavior for other machines and debugger,
+	// exclusive fullscreen, attached or native system menu operations.
+	if (fullscreen() || attached_mode() || (machine().debug_flags & DEBUG_FLAG_OSD_ENABLED) ||
+			std::strcmp(machine().system().name, "cl_millennium") ||
+			(hit != HTCAPTION && (hit < HTLEFT || hit > HTBOTTOMRIGHT)) ||
+			tracking_window_drag() || GetCapture() || !GetWindowRect(platform_window(), &m_drag_bounds))
+		return false;
+
+	m_drag_origin = where;
+	m_drag_hit = hit;
+	m_resize_state = RESIZE_STATE_RESIZING;
+	release_pointer();
+	show_pointer();
+	SetCapture(platform_window());
+	if (GetCapture() != platform_window())
+	{
+		end_window_drag(false);
+		return false;
+	}
+	return true;
+}
+
+void win_window_info::update_window_drag(POINT const &where)
+{
+	RECT bounds = m_drag_bounds;
+	LONG const dx = where.x - m_drag_origin.x;
+	LONG const dy = where.y - m_drag_origin.y;
+	if (m_drag_hit == HTCAPTION)
+		OffsetRect(&bounds, dx, dy);
+	else
+	{
+		if (m_drag_hit == HTLEFT || m_drag_hit == HTTOPLEFT || m_drag_hit == HTBOTTOMLEFT)
+			bounds.left = std::min(bounds.left + dx, bounds.right - MIN_WINDOW_DIMX);
+		if (m_drag_hit == HTRIGHT || m_drag_hit == HTTOPRIGHT || m_drag_hit == HTBOTTOMRIGHT)
+			bounds.right = std::max(bounds.right + dx, bounds.left + MIN_WINDOW_DIMX);
+		if (m_drag_hit == HTTOP || m_drag_hit == HTTOPLEFT || m_drag_hit == HTTOPRIGHT)
+			bounds.top = std::min(bounds.top + dy, bounds.bottom - MIN_WINDOW_DIMY);
+		if (m_drag_hit == HTBOTTOM || m_drag_hit == HTBOTTOMLEFT || m_drag_hit == HTBOTTOMRIGHT)
+			bounds.bottom = std::max(bounds.bottom + dy, bounds.top + MIN_WINDOW_DIMY);
+		if (keepaspect() && target()->scale_mode() == SCALE_FRACTIONAL && !(GetAsyncKeyState(VK_CONTROL) & 0x8000))
+		{
+			auto const r = constrain_to_aspect_ratio(RECT_to_osd_rect(bounds), m_drag_hit - HTLEFT + WMSZ_LEFT);
+			bounds = RECT{ r.left(), r.top(), r.right(), r.bottom() };
+		}
+	}
+	RECT current;
+	if (GetWindowRect(platform_window(), &current) && !EqualRect(&current, &bounds))
+		SetWindowPos(platform_window(), nullptr, bounds.left, bounds.top, rect_width(&bounds), rect_height(&bounds), SWP_NOZORDER | SWP_NOACTIVATE);
+}
+
+void win_window_info::end_window_drag(bool cancel)
+{
+	m_drag_hit = HTNOWHERE;
+	m_resize_state = RESIZE_STATE_PENDING;
+	if (GetCapture() == platform_window())
+		ReleaseCapture();
+	if (cancel)
+		SetWindowPos(platform_window(), nullptr, m_drag_bounds.left, m_drag_bounds.top,
+				rect_width(&m_drag_bounds), rect_height(&m_drag_bounds), SWP_NOZORDER | SWP_NOACTIVATE);
+	update_minmax_state();
+	InvalidateRect(platform_window(), nullptr, FALSE);
+}
